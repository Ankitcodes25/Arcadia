NODE_ENV=development
PORT=4000

# Required for the backend to start. Use a secret manager in production.
MONGODB_URI=mongodb://127.0.0.1:27017/arcadia
JWT_SECRET=

# Exact frontend origins allowed to make credentialed browser requests.
# FRONTEND_URL is the preferred setting; CORS_ORIGIN is retained as a comma-separated alias.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Production cookies are Secure by default. SameSite=None is intended only for a
# separately hosted, HTTPS frontend; use lax or strict for a same-site deployment.
COOKIE_SAME_SITE=lax
# Set an explicit proxy hop count or proxy address list when deployed behind a load balancer.
TRUST_PROXY=false
BCRYPT_COST=10
SECURITY_HSTS_MAX_AGE=31536000

# Google OAuth server-side configuration. Never expose these through frontend VITE_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URL=http://localhost:5173/

# Optional transactional email provider in development.
# Production requires EMAIL_PROVIDER=smtp and all SMTP/link settings below.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/

# Used only by the controlled admin provisioning command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Arcadia Administrator

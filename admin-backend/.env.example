# Arcadia Admin Backend — environment
# Copy to .env and fill in real values. NEVER commit the real .env.

# development | test | production
NODE_ENV=development

# Port the admin backend listens on (player backend uses 4000).
PORT=4100

# The single admin account. There is no registration endpoint — the account
# exists only through these variables.
ADMIN_USERNAME=admin
# The login identifier the shared Arcadia login modal submits (its login field
# is an email input). The server-side resolver uses this to route the attempt
# to the admin account instead of the player flow. Must be unique — no player
# should register with this address.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Exact origin of the admin frontend (Vite dev server by default).
# CORS and cookie behaviour are pinned to this origin.
ADMIN_FRONTEND_ORIGIN=http://localhost:5173

# Session lifetime in minutes (default 240 = 4 hours).
ADMIN_SESSION_TTL_MINUTES=240

# lax | strict | none  (none requires production + HTTPS)
COOKIE_SAME_SITE=lax

# bcrypt cost used when hashing (10–15).
BCRYPT_COST=10

# Number of trusted proxy hops in front of this service (0 = none).
TRUST_PROXY=0
